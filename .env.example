NEXT_PUBLIC_SITE_URL=https://virgue.work
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL of the R2 bucket (r2.dev URL or a custom domain such as https://media.virgue.work)
R2_PUBLIC_BASE_URL=
# Required in production to create the first admin password (via /admin/login)
ADMIN_SETUP_TOKEN=
# Optional: secret used to sign admin session cookies (defaults to the password hash)
ADMIN_AUTH_SECRET=

# Optional: email yourself when a quote request arrives (https://resend.com). Requests are always
# stored and visible in /admin/quotes; this only adds the email.
RESEND_API_KEY=
NOTIFY_TO_EMAIL=
NOTIFY_FROM_EMAIL=

# Quote spam protection (optional): Cloudflare Turnstile. Set both to turn the check on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to 1 to email visitors a short confirmation (needs RESEND_API_KEY).
QUOTE_AUTOREPLY=

# Local/test only: where the file database is stored (defaults to data/db.json).
# DB_PATH=

# AI brief assistant (https://openrouter.ai). Leave the key empty to hide the assistant entirely.
OPENROUTER_API_KEY=
# Any OpenRouter model that reads images and supports JSON replies. Default is a very cheap one.
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Hard cap on assistant replies per day across all visitors (a spend brake). Default 5000.
# CHAT_DAILY_LIMIT=5000

# Lets the daily Vercel cron email you about chats that went quiet. Any long random string.
# CRON_SECRET=

# Thinking before replying: auto (default: a little, only when price comes up), off, low, medium or high. More helps negotiation but costs more.
# OPENROUTER_REASONING=auto

# Discord updates (the separate virgue-discord deployment). Its address shows the subscribe link;
# the secret, the same as its ANNOUNCE_SECRET, lets this site announce newly published work.
# DISCORD_NOTIFY_URL=https://virgue-discord.vercel.app
# DISCORD_ANNOUNCE_SECRET=
